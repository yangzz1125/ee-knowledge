  "entities": [
    {
      "id": "gradient",
      "name": "梯度",
      "type": "concept",
      "summary": "描述标量场在空间中变化最快方向和变化率的矢量。",
      "chapter_id": "vector-analysis",
      "aliases": ["梯度算子"],
      "tags": ["矢量分析", "标量场"],
      "conditions": [],
      "details": {
        "definition": "标量场在某点的梯度是一个矢量，方向为该点标量变化最快的方向，大小为该方向上的最大变化率。",
        "key_points": ["作用对象是标量场，结果是矢量场", "电场强度等于电位的负梯度"],
        "common_misconceptions": ["梯度是矢量，不能与方向导数这样的标量混为一谈"]
      }
    },
    {
      "id": "divergence",
      "name": "散度",
      "type": "concept",
      "summary": "描述矢量场在某点是发散还是汇聚的标量。",
      "chapter_id": "vector-analysis",
      "aliases": ["散度算子"],
      "tags": ["矢量分析", "矢量场"],
      "conditions": [],
      "details": {
        "definition": "矢量场在某点的散度是该点单位体积内通量的极限，为标量。",
        "key_points": ["作用对象是矢量场，结果是标量场", "散度定理把体积分与闭合面积分联系起来"],
        "common_misconceptions": ["散度是标量，不带方向"]
      }
    },
